# FocalTechTouch-FT8719 example configuration (values intentionally blank).
# Override these keys in your board/OS config (e.g. UniXNU-merlinx/configs/merlinx-iOS16.7.config).
# At build time, UniXNU-merlinx injects -DCONFIG_XNU_DW_FOCALTECH_* when compiling FtsProbe/FtsTouchCore.
#
# Supported parameters:
#
# SPI0 clock frequency in Hz and chip-select index (defaults: 8000000 / 0).
CONFIG_XNU_DW_FOCALTECH_SPI_HZ=
CONFIG_XNU_DW_FOCALTECH_SPI_CS=

# MediaTek GPIO numbers for panel reset and interrupt (defaults: 92 / 1).
CONFIG_XNU_DW_FOCALTECH_RESET_GPIO=
CONFIG_XNU_DW_FOCALTECH_IRQ_GPIO=

# Panel logical touch geometry and max simultaneous contacts (defaults: 1080 / 2340 / 10).
CONFIG_XNU_DW_FOCALTECH_X_MAX=
CONFIG_XNU_DW_FOCALTECH_Y_MAX=
CONFIG_XNU_DW_FOCALTECH_MAX_POINTS=

# Axis transform flags (0 or 1; defaults: 0 / 0 / 0).
CONFIG_XNU_DW_FOCALTECH_SWAP_XY=
CONFIG_XNU_DW_FOCALTECH_INVERT_X=
CONFIG_XNU_DW_FOCALTECH_INVERT_Y=
